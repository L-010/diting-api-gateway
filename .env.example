APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-32-byte-secret
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
API_KEY_PEPPER=replace-with-a-random-pepper
DATABASE_URL=sqlite:///./data/api_gateway.db
# 生产 MySQL 示例：mysql+pymysql://api_user:URL编码后的密码@mysql:3306/api_gateway?charset=utf8mb4
ALLOWED_UPSTREAM_HOSTS=127.0.0.1,localhost
TOMODD_BASE_URL=http://127.0.0.1:18000
TOMODD_UPSTREAM_TOKEN=
MAX_UPLOAD_BYTES=104857600
MAX_DOWNLOAD_BYTES=1073741824
SESSION_COOKIE_NAME=agw_session
FRONTEND_ORIGIN=http://127.0.0.1:3000
# 用户文档与代码示例使用的公开根地址；也可在“平台设置 -> 网关与域名”中覆盖。
PUBLIC_GATEWAY_BASE_URL=
BRAND_ASSET_DIR=./data/brand-assets
CALL_LOG_RETENTION_DAYS=90
SUPPORT_CONTACT=
# 首次启动可用环境变量提供 SMTP；管理员保存“平台设置”后数据库配置会即时覆盖以下值。
SMTP_HOST=
# 163 邮箱建议使用 465 + 隐式 SSL；使用 587 时才设置 SMTP_USE_TLS=true。
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
# 分布式文件与制品。文件正文始终留在工具服务器，以下仅控制平台代理和后台同步。
MAX_REMOTE_FILE_BYTES=53687091200
FILE_DOWNLOAD_CONCURRENCY_PER_USER=4
FILE_DOWNLOAD_CONCURRENCY_PER_TOOL=16
FILE_DOWNLOAD_AUTHORIZATION_MINUTES=5
# 下载槽租约用于回收浏览器中断后未正常结束的并发名额。
FILE_DOWNLOAD_LEASE_SECONDS=180
FILE_SYNC_POLL_SECONDS=15
FILE_VERIFY_INTERVAL_SECONDS=86400
FILE_SYNC_MANIFEST_MAX_BYTES=1048576
FILE_SYNC_MANIFEST_MAX_ITEMS=1000
# 超过该时间未更新的工具存储水位不能用于新的写入决策。
STORAGE_WATERMARK_MAX_AGE_SECONDS=300
