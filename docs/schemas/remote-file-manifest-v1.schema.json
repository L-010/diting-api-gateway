{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-gateway.local/schemas/remote-file-manifest-v1.schema.json",
  "title": "平台制品 Manifest v1",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifacts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["file_id", "name", "role", "visibility", "status", "size_bytes", "created_at"],
        "properties": {
          "file_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\x00-\\x1f\\x7f]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "role": { "enum": ["input", "intermediate", "output", "log", "archive"] },
          "visibility": { "enum": ["user", "admin", "internal"] },
          "status": { "enum": ["pending", "ready", "delete_pending", "deleted", "expired", "missing", "quarantined", "error"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "content_type": { "type": "string", "maxLength": 255 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "additionalProperties": true
}
