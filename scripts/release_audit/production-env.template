# 生产目标环境变量名称模板；只填写到受控密钥管理系统，不提交仓库。
APP_ENV=production
APP_SECRET_KEY=<由密钥管理系统注入>
APP_ENCRYPTION_KEY=<由密钥管理系统注入>
API_KEY_PEPPER=<由密钥管理系统注入>
DATABASE_URL=<目标数据库连接串>
ALLOWED_UPSTREAM_HOSTS=<隔离且最小化的主机白名单>
TOMODD_BASE_URL=<隔离或生产批准的 TomoDD 根地址>
TOMODD_UPSTREAM_TOKEN=<由密钥管理系统注入>
FRONTEND_ORIGIN=<正式前端根地址>
PUBLIC_GATEWAY_BASE_URL=<正式网关根地址>
SMTP_HOST=<非生产联调或正式批准地址>
SMTP_PORT=587
SMTP_USERNAME=<由密钥管理系统注入>
SMTP_PASSWORD=<由密钥管理系统注入>
SMTP_FROM=<已验证发件人>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_TEST_MODE=false
AGW_HOST=0.0.0.0
AGW_PORT=8000
AGW_WORKERS=1
AGW_MULTI_INSTANCE=false
PRODUCTION_SQLITE_EXCEPTION_APPROVED=false
EXPECTED_ALEMBIC_HEAD=a6b7c8d9e0f1
RELEASE_TARGET_ENV=production
RELEASE_VALIDATION_ACK=I_UNDERSTAND_TARGET_ENV
BACKUP_VERIFIED=false
BACKUP_VERIFICATION_ID=<外部备份系统证据编号>
MIGRATION_CHANGE_APPROVED=false
