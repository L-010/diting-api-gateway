# 生产环境配置模板。
# 当前部署指南使用 HTTP 直连模式；启用 HTTPS 前请将 SECURE_COOKIES 改为 true。

APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
API_KEY_PEPPER=replace-with-a-random-pepper

MYSQL_DATABASE=api_gateway
MYSQL_USER=api_user
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-random-root-password
# 如果密码包含 URL 保留字符，必须先进行 URL 编码；推荐使用十六进制随机密码。
DATABASE_URL=mysql+pymysql://api_user:replace-with-a-random-database-password@mysql:3306/api_gateway?charset=utf8mb4

# 上游服务必须是 backend 容器可访问的地址，主机名必须出现在白名单中。
ALLOWED_UPSTREAM_HOSTS=host.docker.internal,127.0.0.1,localhost
TOMODD_BASE_URL=http://host.docker.internal:18000
TOMODD_UPSTREAM_TOKEN=

# 文件与品牌资源
MAX_UPLOAD_BYTES=104857600
MAX_DOWNLOAD_BYTES=1073741824
MAX_REMOTE_FILE_BYTES=53687091200
FILE_DOWNLOAD_CONCURRENCY_PER_USER=4
FILE_DOWNLOAD_CONCURRENCY_PER_TOOL=16
FILE_DOWNLOAD_AUTHORIZATION_MINUTES=5
FILE_DOWNLOAD_LEASE_SECONDS=180
FILE_SYNC_POLL_SECONDS=15
FILE_VERIFY_INTERVAL_SECONDS=86400
STORAGE_WATERMARK_MAX_AGE_SECONDS=300
FILE_SYNC_MANIFEST_MAX_BYTES=1048576
FILE_SYNC_MANIFEST_MAX_ITEMS=1000
BRAND_ASSET_DIR=/app/data/brand-assets

# HTTP 直连地址；必须改成用户实际访问前端的 Origin 和公开网关地址。
FRONTEND_ORIGIN=http://10.2.210.10:3000
PUBLIC_GATEWAY_BASE_URL=http://10.2.210.10:8000

# 会话与认证
SESSION_COOKIE_NAME=agw_session
SECURE_COOKIES=false
ACCESS_TOKEN_MINUTES=480
LOGIN_PROTECTION_ENABLED=true
LOGIN_FAILURE_LIMIT=5
LOCK_MINUTES=15

# 日志与邮件
CALL_LOG_RETENTION_DAYS=90
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
SUPPORT_CONTACT=
EMAIL_TEST_MODE=false

# Docker Compose 与迁移
EXPECTED_ALEMBIC_HEAD=a6b7c8d9e0f1
MYSQL_DATA_DIR=/Data/earthquake-api-gateway/mysql
BRAND_ASSET_DIR_HOST=/Data/earthquake-api-gateway/brand-assets
BACKUP_DIR=/Data/earthquake-api-gateway/backups/mysql
BACKUP_RETENTION_DAYS=14
BACKEND_PORT=8000
FRONTEND_PORT=3000
COMPOSE_PROJECT_NAME=earthquake-api-gateway
