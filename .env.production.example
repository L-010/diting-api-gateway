APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-32-byte-secret
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
API_KEY_PEPPER=replace-with-a-random-pepper

MYSQL_DATABASE=api_gateway
MYSQL_USER=api_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
DATABASE_URL=mysql+pymysql://api_user:replace-with-a-strong-database-password@mysql:3306/api_gateway?charset=utf8mb4

ALLOWED_UPSTREAM_HOSTS=127.0.0.1,localhost
TOMODD_BASE_URL=https://replace-with-approved-upstream
TOMODD_UPSTREAM_TOKEN=replace-with-upstream-token
FRONTEND_ORIGIN=https://api.example.com
PUBLIC_GATEWAY_BASE_URL=https://api.example.com
SERVER_NAME=api.example.com

SMTP_HOST=
# 163 邮箱建议使用 465 + 隐式 SSL；使用 587 时才设置 SMTP_USE_TLS=true。
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_TEST_MODE=false

MAX_UPLOAD_BYTES=104857600
MAX_DOWNLOAD_BYTES=1073741824
MAX_REMOTE_FILE_BYTES=53687091200
CALL_LOG_RETENTION_DAYS=90
BRAND_ASSET_DIR=/app/data/brand-assets
AGW_WORKERS=2
BACKEND_PORT=8000
FRONTEND_PORT=3000
MYSQL_DATA_DIR=/Data/api-mvp/mysql
BRAND_ASSET_DIR_HOST=/Data/api-mvp/brand-assets
BACKUP_DIR=/Data/api-mvp/backups/mysql
BACKUP_RETENTION_DAYS=14
TLS_CERT_FILE=/etc/ssl/api-gateway/fullchain.pem
TLS_KEY_FILE=/etc/ssl/api-gateway/privkey.pem
EXPECTED_ALEMBIC_HEAD=a6b7c8d9e0f1
